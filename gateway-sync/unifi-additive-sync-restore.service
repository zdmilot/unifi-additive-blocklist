[Unit]
Description=Restore the UniFi additive DNS blocklist schedule from persistent storage
After=local-fs.target
RequiresMountsFor=/data/unifi-additive-sync

[Service]
Type=oneshot
ExecStart=/bin/bash /data/unifi-additive-sync/restore-schedule.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
